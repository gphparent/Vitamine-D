{
  "manifest_version": 3,
  "name": "Appli YouTube",
  "version": "1.1.0",
  "description": "YouTube, mais seulement ce qu'un juge a approuvé.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_title": "Appli YouTube",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png"
    }
  },
  "background": {
    "service_worker": "arriere-plan.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://i.ytimg.com/*",
    "https://api.anthropic.com/*",
    "https://api.github.com/*",
    "https://gist.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "regles-youtube.js",
        "surveillance.js"
      ],
      "css": [
        "surveillance.css"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "referent",
        "enabled": true,
        "path": "regles.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube-nocookie.com"
  }
}
