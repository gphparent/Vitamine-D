<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Le bouton « Ouvrir PP Terrain » de l'admin ouvre ppterrain://connexion?code=… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ca.gphparent.PPTerrain</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ppterrain</string>
			</array>
		</dict>
	</array>
	<!-- Le groupe du trousseau où l'appli dépose les séances du widget « Prochaine séance » (Partage/Prochaines.swift). -->
	<key>GroupeTrousseau</key>
	<string>$(AppIdentifierPrefix)ca.gphparent.PPTerrain.partage</string>
	<!-- L'arrivée et la fin des séances notées par le GPS (Presence.swift). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PP Terrain note l’heure de votre arrivée et de votre départ des séances. Aucune position n’est envoyée.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Choisissez « Toujours » : PP Terrain note l’heure de votre arrivée et de votre départ des séances, même fermée, pour le suivi et le carnet de kilométrage. Aucune position n’est envoyée.</string>
</dict>
</plist>
