<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Le groupe de l'appli d'abord : le jeton continue d'y être écrit, hors de portée de l'extension.
	     Le second groupe sert seulement aux séances du widget. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)ca.gphparent.PPTerrain</string>
		<string>$(AppIdentifierPrefix)ca.gphparent.PPTerrain.partage</string>
	</array>
</dict>
</plist>
